{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fundlark-community",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-08",
  "assets": {"directory": "../../docs/demo", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "fundlark-community", "database_id": "REPLACE_WITH_DATABASE_ID"}],
  "vars": {"DAILY_REQUEST_LIMIT": "1000", "PER_VISITOR_DAILY_LIMIT": "30"},
  "observability": {"enabled": false}
}
