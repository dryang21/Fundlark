{
  "name": "fundlark",
  "private": true,
  "scripts": {
    "test": "node --test tests-js/*.test.mjs",
    "dev:community": "wrangler dev --config services/community/wrangler.jsonc",
    "db:local": "wrangler d1 execute DB --local --config services/community/wrangler.jsonc --file services/community/schema.sql",
    "deploy:community": "wrangler deploy --config services/community/wrangler.jsonc"
  },
  "devDependencies": {"wrangler": "4.158.0"},
  "engines": {"node": ">=22"}
}
